@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var pageTitle = ViewData["Title"] as string;
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var storedToast = PoolCar.Web.Htmx.Toast.Take(TempData);
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@requestToken" />
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? "PoolCar" : $"{pageTitle} | PoolCar")</title>
    <link rel="preload" href="~/fonts/inter/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/inter/Inter-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/htmx/htmx-2.0.11.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body hx-boost="true" hx-headers='{"RequestVerificationToken": "@requestToken"}'>
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="/">PoolCar</a>

            <form class="plate-search" action="/zoeken" method="get" role="search">
                <label class="visually-hidden" for="kenteken-zoeken">Kenteken zoeken</label>
                <input id="kenteken-zoeken" name="kenteken" type="search" placeholder="Kenteken zoeken" autocomplete="off" spellcheck="false" />
                <button type="submit" class="button button-small">Zoek</button>
            </form>

            @if (signedIn)
            {
                <details class="menu nav-menu">
                    <summary>Menu</summary>
                    <nav class="menu-panel" aria-label="Hoofdnavigatie">
                        <partial name="_NavLinks" />
                    </nav>
                </details>

                @await Component.InvokeAsync("UserMenu")

                <nav class="site-nav" aria-label="Hoofdnavigatie">
                    <partial name="_NavLinks" />
                </nav>
            }
        </div>
    </header>

    <main id="main-content" class="site-main" tabindex="-1">
        @RenderBody()
    </main>

    <div id="toasts" class="toasts" aria-live="polite">
        @if (storedToast is not null)
        {
            <partial name="_Toast" model="storedToast" />
        }
    </div>

    <footer class="site-footer">
        <div class="container">PoolCar</div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
