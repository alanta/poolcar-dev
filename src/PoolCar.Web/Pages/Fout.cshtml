@page "/fout/{status:int?}"
@model FoutModel
@{
    ViewData["Title"] = Model.Title;
    var isPartial = HttpContext.Request.IsHtmxPartial();
    if (Model.Status == StatusCodes.Status503ServiceUnavailable)
    {
        HttpContext.Response.Headers[PoolCar.Web.Outages.ServiceUnavailableMiddleware.MarkerHeader] = "true";
    }

    if (isPartial)
    {
        // Keep the page and its address as they are and only show the message
        Layout = null;
        HttpContext.Response.Headers[HtmxRequestExtensions.ReswapHeader] = "none";
        HttpContext.Response.Headers[HtmxRequestExtensions.PushUrlHeader] = "false";
    }
}
@if (isPartial)
{
    <partial name="_ToastOob" model="Toast.Error(Model.Message)" />
}
else
{
    <div class="container">
        <h1>@Model.Title</h1>
        <p class="lead">@Model.Message</p>

        @if (Model.Status >= 500)
        {
            <p>Blijft het misgaan? Geef dan deze code door aan de servicedesk:</p>
            <p><code class="trace-id">@Model.TraceId</code></p>
        }

        <div class="button-row">
            <a class="button button-dark" href="/">Naar het overzicht</a>
        </div>
    </div>
}
