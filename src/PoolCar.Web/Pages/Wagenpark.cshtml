@page "/wagenpark"
@model WagenparkModel
@{
    ViewData["Title"] = "Wagenpark";
}

<div class="container">
    <h1>Wagenpark</h1>
    <p class="lead">Welke auto's hebben we? Kies een vestiging en bekijk de auto's per categorie.</p>

    @if (Model.SelectedOffice is not null)
    {
        <form method="get" action="/wagenpark" class="fleet-filter"
              hx-get="/wagenpark" hx-target="#wagenpark-autos" hx-trigger="change, submit"
              hx-push-url="true" hx-indicator="#wagenpark-spinner">
            <div class="form-field">
                <label for="vestiging">Vestiging</label>
                <select id="vestiging" name="vestiging">
                    @foreach (var office in Model.Offices)
                    {
                        <option value="@office.Id" selected="@(office.Id == Model.SelectedOffice.Id)">@office.Name</option>
                    }
                </select>
            </div>
            <fieldset>
                <legend>Categorie</legend>
                <div class="segmented">
                    <label>
                        <input type="radio" name="categorie" value="" checked="@(Model.SelectedCategory is null)" />
                        <span>Alle</span>
                    </label>
                    @foreach (var category in Model.Categories)
                    {
                        <label>
                            <input type="radio" name="categorie" value="@category.Id" checked="@(category.Id == Model.SelectedCategory?.Id)" />
                            <span>@category.Name</span>
                        </label>
                    }
                </div>
            </fieldset>
            <div class="button-row">
                <button type="submit" class="button button-dark">Bekijk</button>
                <span id="wagenpark-spinner" class="spinner" aria-hidden="true"></span>
            </div>
        </form>
    }

    <div id="wagenpark-autos" class="section">
        <partial name="_WagenparkCars" model="Model" />
    </div>
</div>
